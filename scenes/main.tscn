[node name="Terrain" type="StaticBody3D" parent="."]
script = ExtResource("2_terrain")

; The tower and the villages stand before the scatter and the camps on purpose: they register
; the ground they own, and every placer after them asks before it drops something on it.
[node name="Tower" type="Node3D" parent="."]
script = ExtResource("15_tower")

[node name="Villages" type="Node3D" parent="."]
script = ExtResource("16_villages")

[node name="Scatter" type="Node3D" parent="."]
script = ExtResource("5_scatter")
; The valley is 2.5 times the area it was, and the scatter is per square metre. Left at 1.0 the
; trees, ferns and pebbles would have multiplied with the map and the new ground would be a
; thicker forest than the old one rather than more of the same country. Knocked down so a walk
; across it reads the same, with room between the trunks to see who is coming.
density_multiplier = 0.45

